<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <RootNamespace>EscalaAvulsos.Infraestrutura.Testes</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\EscalaAvulsos.Infraestrutura\EscalaAvulsos.Infraestrutura.csproj" />
  </ItemGroup>
  <!--
    Os trabalhadores, as requisições e a tarde de quinta dos testes do
    domínio, compilados aqui também: o que se grava e se lê é exatamente o
    que o domínio já conferiu. Quatro arquivos não justificam uma biblioteca
    de testes compartilhada.
  -->
  <ItemGroup>
    <Compile Include="..\EscalaAvulsos.Dominio.Testes\Trabalhadores\TrabalhadoresDeTeste.cs" Link="Exemplos\TrabalhadoresDeTeste.cs" />
    <Compile Include="..\EscalaAvulsos.Dominio.Testes\Requisicoes\RequisicoesDeTeste.cs" Link="Exemplos\RequisicoesDeTeste.cs" />
    <Compile Include="..\EscalaAvulsos.Dominio.Testes\Escalacoes\EscalacoesDeTeste.cs" Link="Exemplos\EscalacoesDeTeste.cs" />
    <Compile Include="..\EscalaAvulsos.Dominio.Testes\Escalacoes\TardeDeQuinta.cs" Link="Exemplos\TardeDeQuinta.cs" />
  </ItemGroup>
</Project>
