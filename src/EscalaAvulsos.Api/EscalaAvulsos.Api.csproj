<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    A API REST: o contrato HTTP da escala. Autentica, autoriza, traduz pedidos
    em chamadas ao domínio e erros em ProblemDetails. Regra de negócio aqui
    não há — está no domínio.
  -->
  <PropertyGroup>
    <RootNamespace>EscalaAvulsos.Api</RootNamespace>
    <!-- Onde o dotnet user-jwts guarda a chave dos tokens de desenvolvimento. -->
    <UserSecretsId>escala-avulsos-api</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\EscalaAvulsos.Infraestrutura\EscalaAvulsos.Infraestrutura.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="EscalaAvulsos.Api.Testes" />
    <InternalsVisibleTo Include="EscalaAvulsos.Api.Ensaio" />
  </ItemGroup>
</Project>
