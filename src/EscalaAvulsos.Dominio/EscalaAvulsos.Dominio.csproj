<Project Sdk="Microsoft.NET.Sdk">
  <!--
    O domínio não tem PackageReference nenhum, e o teste de arquitetura
    garante que continue assim: ele depende só da biblioteca padrão do .NET.
  -->
  <PropertyGroup>
    <RootNamespace>EscalaAvulsos.Dominio</RootNamespace>
  </PropertyGroup>
  <!--
    Só a persistência enxerga os internos: é ela que refaz os agregados
    gravados, com a identidade que eles já tinham (ADR-0011). Os testes do
    domínio continuam pela porta da frente.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="EscalaAvulsos.Infraestrutura" />
  </ItemGroup>
</Project>
