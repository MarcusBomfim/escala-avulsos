<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tudo o que o domínio não sabe: como os agregados viram documentos JSON e
    como os documentos vão para o PostgreSQL. Depende do domínio; o domínio
    não depende daqui.
  -->
  <PropertyGroup>
    <RootNamespace>EscalaAvulsos.Infraestrutura</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Só para o dotnet-ef gerar migrações; não vai para quem usa o projeto. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\EscalaAvulsos.Dominio\EscalaAvulsos.Dominio.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="EscalaAvulsos.Infraestrutura.Testes" />
  </ItemGroup>
</Project>
